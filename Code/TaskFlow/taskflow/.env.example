# ---------- app ----------
TASKFLOW_ENV=local
TASKFLOW_TENANT_ID=taskflow-demo
TASKFLOW_API_TOKEN=change-me-local-bearer-token
DATABASE_URL=sqlite+aiosqlite:///./data/taskflow.db

# ---------- retrieval (embedded — no server) ----------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=taskflow_kb

# ---------- llm ----------
# cloud_first = Claude primary, Ollama fallback
# local_only  = Ollama only. Use this for the demo if your key has expired,
#               or to prove the system runs with no network at all.
TASKFLOW_LLM_MODE=cloud_first
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# model ids live in config/providers.yaml, never here and never in code

# ---------- gmail ----------
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json
GMAIL_POLL_SECONDS=30
GMAIL_LABEL=INBOX
OPS_EMAIL=you@example.com

# ---------- alerts ----------
# Power Automate Workflows webhook URL. Office 365 connector webhooks were
# permanently disabled in May 2026 — do NOT use an old connector URL.
# Teams -> channel -> ... -> Workflows -> "Post to a channel when a webhook
# request is received" -> copy the HTTP POST URL.
# Leave blank to fall back to the dashboard alert panel + email.
TEAMS_WEBHOOK_URL=




#SMTP + IMAP Protocol 

GMAIL_USER=supportfortaskflow@gmail.com
GMAIL_APP_PASSWORD=xiqz cwfg zvzg rgsw
GMAIL_POLL_SECONDS=30
GMAIL_LABEL=INBOX
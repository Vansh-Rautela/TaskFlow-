# ---------- app ----------
TASKFLOW_ENV=local
TASKFLOW_TENANT_ID=taskflow-demo
TASKFLOW_API_TOKEN=change-me-local-bearer-token
DATABASE_URL=sqlite+aiosqlite:///./data/taskflow.db

# ---------- retrieval (embedded — no server) ----------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=taskflow_kb

# ---------- llm ----------
# cloud_first = OpenRouter -> Claude -> Ollama fallback
# local_only  = Ollama local offline
TASKFLOW_LLM_MODE=cloud_first
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-api03-...
OLLAMA_BASE_URL=http://localhost:11434

# ---------- gmail / email ----------
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json
GMAIL_USER=supportfortaskflow@gmail.com
GMAIL_APP_PASSWORD=xiqz cwfg zvzg rgsw
GMAIL_POLL_SECONDS=30
GMAIL_LABEL=INBOX
OPS_EMAIL=supportfortaskflow@gmail.com

# ---------- multi-channel alerts ----------
TEAMS_WEBHOOK_URL=https://prod-XX.westus.logic.azure.com:443/workflows/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-100123456789
ALERT_WEBHOOK_URL=https://example.com/api/webhooks/alerts
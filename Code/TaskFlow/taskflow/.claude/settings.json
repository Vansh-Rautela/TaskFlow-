{
  "permissions": {
    "allow": [
      "Bash(uv run:*)", "Bash(uv sync:*)", "Bash(make:*)", "Bash(pytest:*)",
      "Bash(alembic upgrade:*)", "Bash(alembic revision:*)", "Bash(ollama list)",
      "Bash(sqlite3:*)", "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)", "Bash(git push --force:*)", "Bash(git reset --hard:*)",
      "Bash(alembic downgrade:*)",
      "Read(./.env)", "Read(./secrets/**)", "Edit(./.env)", "Edit(./secrets/**)",
      "Edit(./data/snapshots/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "cd $CLAUDE_PROJECT_DIR && uv run pytest tests/unit -q 2>&1 | tail -5" }
        ]
      }
    ]
  }
}
